local Library = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/nuke1235/lib/refs/heads/main/ui.lua"
))()

local Options = Library.Options
local Toggles = Library.Toggles

local Menu = Library:CreateMenu({
    AnimationEnabled = true,
    AnimationDuration = 0.1,
    ConfigFolder = "configs",
})

local Tabs = {
    Main = Menu:AddTab("Main"),
    Select = Menu:AddTab("Selection"),
    Input = Menu:AddTab("Input"),
    Settings = Menu:AddTab("Management"),
}

local Basic = Tabs.Main:AddLeftGroupbox("Toggles and Sliders")
Basic:AddToggle("Enabled", { Text = "Enabled", Default = true, Tooltip = "Change the toggle value." })
    :AddKeyPicker("EnabledKey", { Default = "F8", Mode = "Toggle", SyncToggleState = true })
Basic:AddCheckbox("Checkbox", {
    Text = "Checkbox", Default = false,
    Callback = function(value) print("Checkbox:", value) end,
})
Basic:AddSlider("Amount", { Text = "Amount", Default = 50, Min = 0, Max = 100, Rounding = 0, Suffix = "%" })
Basic:AddSlider("Speed", { Text = "Speed", Default = 1, Min = 0.1, Max = 5, Rounding = 2 })
Basic:AddToggle("Advanced", { Text = "Show advanced options", Default = false })

local Advanced = Basic:AddDependencyBox()
Advanced:AddSlider("AdvancedAmount", { Text = "Advanced amount", Default = 10, Min = 1, Max = 50, Rounding = 0 })
Advanced:SetupDependencies({ { Toggles.Advanced, true } })

local Actions = Tabs.Main:AddRightGroupbox("Buttons and Status")
local Status = Actions:AddLabel("Status: Ready")
Actions:AddButton({
    Text = "Show current values",
    Func = function()
        print("Enabled:", Toggles.Enabled.Value)
        print("Amount:", Options.Amount.Value)
        print("Speed:", Options.Speed.Value)
        Status:SetText("Status: Values checked")
    end,
}):AddButton({ Text = "Notify", Func = function() Menu:Notify({ Text = "Button clicked.", Duration = 3 }) end })
Actions:AddButton({
    Text = "Double click", DoubleClick = true, Tooltip = "Click twice within 0.4 seconds.",
    Func = function() Status:SetText("Status: Double click confirmed") end,
})
local DisabledButton = Actions:AddButton({
    Text = "Disabled button", Disabled = true, DisabledTooltip = "Enable the toggle below to use this button.",
    Func = function() Menu:Notify("The button is enabled.") end,
})
Actions:AddToggle("ButtonEnabled", { Text = "Enable button", Default = false })
Toggles.ButtonEnabled:OnChanged(function(value) DisabledButton:SetDisabled(not value) end)
Actions:AddDivider()
Actions:AddLabel("Color"):AddColorPicker("InlineColor", { Default = Color3.fromRGB(255, 180, 90), Transparency = 0 })

local SearchValues = { "Apple", "Banana", "Cherry", "Grape", "Orange", "Peach", "Pear", "Mango", "Melon" }
local Dropdowns = Tabs.Select:AddLeftGroupbox("Dropdowns")
Dropdowns:AddDropdown("SingleChoice", {
    Text = "Single selection", Values = { "First", "Second", "Third" }, Default = 1, AllowNull = false,
})
Dropdowns:AddDropdown("SearchChoice", {
    Text = "Searchable selection", Values = SearchValues,
    Default = "Apple", Searchable = true, MaxVisibleDropdownItems = 5,
})
Dropdowns:AddDropdown("MultiChoice", { Text = "Multiple selection", Values = { "A", "B", "C", "D" }, Default = { "A", "C" }, Multi = true })
Dropdowns:AddDropdown("DictionaryChoice", { Text = "Custom display names", Values = { low = "Low", medium = "Medium", high = "High" }, Default = "medium" })
Dropdowns:AddDropdown("DisabledChoice", { Text = "Disabled items", Values = { "Available", "Locked" }, Default = "Available", DisabledValues = { "Locked" } })
Dropdowns:AddButton({
    Text = "Change search list",
    Func = function()
        Options.SearchChoice:SetValues({ "Alpha", "Beta", "Gamma", "Delta" })
        Options.SearchChoice:SetValue("Beta")
    end,
})

local Pickers = Tabs.Select:AddRightTabbox()
local Colors = Pickers:AddTab("Colors")
local Keys = Pickers:AddTab("Keybinds")
Colors:AddColorPicker("Color", { Text = "Color picker", Default = Color3.fromRGB(85, 135, 255), Transparency = 0.2 })
Colors:AddColorPicker("SecondColor", { Text = "Another color", Default = Color3.fromRGB(140, 220, 170) })
Colors:AddButton({ Text = "Set color to green", Func = function() Options.Color:SetValueRGB(Color3.fromRGB(0, 255, 140), 0.1) end })
Keys:AddKeyPicker("PressKey", { Text = "Run on press", Default = "F6", Mode = "Press", Callback = function() print("Keybind triggered") end })
Keys:AddKeyPicker("HoldKey", { Text = "While held", Default = "F7", Mode = "Hold" })
Keys:AddKeyPicker("ToggleKey", { Text = "Toggle on / off", Default = "F9", Mode = "Toggle" })
Keys:AddLabel("Click a button to assign a key, or right click to change its mode.")

local Inputs = Tabs.Input:AddLeftGroupbox("Inputs")
Inputs:AddInput("Text", { Text = "Text", Default = "Hello", Placeholder = "Enter text here" })
Inputs:AddInput("Number", { Text = "Number", Default = "123", Numeric = true, Finished = true })
Inputs:AddInput("FinishedText", { Text = "Apply on finish", Default = "", Finished = true })
Inputs:AddInput("MultiLine", { Text = "Multiple lines", Default = "First line\nSecond line", MultiLine = true })

local Output = Tabs.Input:AddRightGroupbox("Output")
Output:AddLabel("TextStatus", { Text = "Input: Hello" })
Output:AddParagraph("Description", "Read control values from Options or Toggles.")
Output:AddButton({
    Text = "Change values from code",
    Func = function()
        Toggles.Enabled:SetValue(false)
        Options.Amount:SetValue(75)
        Options.Text:SetValue("Changed from code.")
        Options.MultiChoice:SetValue({ A = true, D = true })
        Options.PressKey:SetValue({ "F6", "Press" })
    end,
})

local Appearance = Tabs.Settings:AddLeftGroupbox("Appearance")
Appearance:AddToggle("Animation", { Text = "Transition animation", Default = true })
Appearance:AddSlider("AnimationDuration", { Text = "Transition duration", Default = 0.1, Min = 0.05, Max = 0.6, Rounding = 2, Suffix = "s" })
Appearance:AddColorPicker("Accent", { Text = "Accent color", Default = Color3.fromRGB(85, 135, 255) })

local Config = Tabs.Settings:AddRightGroupbox("Configuration")
Config:AddInput("ConfigName", { Text = "File name", Default = "default", Finished = true, IgnoreConfig = true })
Config:AddButton({
    Text = "Save",
    Func = function()
        local ok, message = pcall(function() Menu:SaveConfig(Options.ConfigName.Value) end)
        Menu:Notify(ok and "Configuration saved." or tostring(message))
    end,
}):AddButton({
    Text = "Load",
    Func = function()
        local ok, loaded, message = pcall(function() return Menu:LoadConfigFile(Options.ConfigName.Value) end)
        Menu:Notify(ok and loaded and "Configuration loaded." or tostring(ok and message or loaded))
    end,
})

local defaults
Config:AddButton({ Text = "Restore defaults", Func = function()
    Options.SearchChoice:SetValues(SearchValues)
    Menu:LoadConfig(defaults)
end })
Config:AddButton({ Text = "Unload UI", Func = function() Menu:Unload() end })

Toggles.Enabled:OnChanged(function(value) print("Enabled:", value) end)
Options.Amount:OnChanged(function(value) print("Amount:", value) end)
Options.Speed:OnChanged(function(value) print("Speed:", value) end)
Options.SingleChoice:OnChanged(function(value) print("Single selection:", value) end)
Options.DictionaryChoice:OnChanged(function(value) print("Selected value:", value) end)
Options.MultiChoice:OnChanged(function(value) for key in pairs(value) do print("Selected item:", key) end end)
Options.Color:OnChanged(function(color, transparency) print("Color:", color, "Transparency:", transparency) end)
Options.HoldKey:OnClick(function(value) print("Held:", value) end)
Options.ToggleKey:OnClick(function(value) print("Keybind state:", value) end)
Options.PressKey:OnChanged(function(value) print("Assigned key:", value, Options.PressKey.Mode) end)
Options.Text:OnChanged(function(value) Options.TextStatus:SetText("Input: " .. value) end)
Toggles.Animation:OnChanged(function(value) Menu:SetAnimationEnabled(value) end)
Options.AnimationDuration:OnChanged(function(value) Menu:SetAnimationDuration(value) end)
Options.Accent:OnChanged(function(value) Menu:SetAccent(value) end)
Menu:OnUnload(function() print("UI unloaded") end)

defaults = Menu:GetConfig()
